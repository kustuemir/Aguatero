
    padding: 4px 10px 12px;
  }
  .tab-btn {
    flex: 1;
    max-width: 160px;
    padding: 10px 4px;
    text-align: center;
    background: rgba(255,255,255,0.12);
    border: none;
    border-radius: 8px;
    font-size: 0.88em;
    color: white;
    opacity: 0.75;
  }
  .tab-btn.active {
    background: var(--azul-hondo);
    opacity: 1;
    font-weight: bold;
  }
  .view { display: none; padding: 14px; }
  .view.active { display: block; }
  .card {
    background: white;
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
  }
  .card h3 { margin: 0 0 6px; font-size: 1.05em; }
  .row { display: flex; justify-content: space-between; font-size: 0.9em; margin: 2px 0; }
  .deuda { color: var(--rojo-deuda); font-weight: bold; }
  .saldo-ok { color: var(--verde-pago); font-weight: bold; }
  .btn {
    background: var(--azul-medio);
    color: white;
    border: none;
    padding: 10px 16px;
    border-radius: 10px;
    font-size: 0.95em;
    width: 100%;
    margin-top: 8px;
  }
  .btn.naranja { background: var(--naranja); }
  .btn.verde { background: var(--verde-pago); }
  .btn.chico { width: auto; padding: 6px 10px; font-size: 0.78em; }
  .btn.rojo { background: var(--rojo-deuda); }
  .btn.outline { background: white; color: var(--azul-medio); border: 1px solid var(--azul-medio); }
  .btn-row { display: flex; gap: 6px; margin-top: 8px; }
  .btn-row .btn { margin-top: 0; flex: 1; font-size: 0.78em; padding: 8px 4px; }
  input, select {
    width: 100%;
    padding: 10px;
    margin: 6px 0;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 0.95em;
  }
  label { font-size: 0.8em; color: #666; }
  .section-title {
    background: var(--azul-medio);
    color: white;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.8em;
    letter-spacing: 0.5px;
    margin: 14px 0 8px;
    text-transform: uppercase;
  }
  .movimientos { max-height: 200px; overflow-y: auto; }
  .mov-item { font-size: 0.82em; padding: 6px 0; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; gap: 8px; }
  .empty-msg { text-align: center; color: #999; padding: 30px 10px; font-size: 0.9em; }
  .fab {
    position: fixed;
    bottom: 76px;
    right: 20px;
    background: var(--naranja);
    color: white;
    border: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    font-size: 1.6em;
    box-shadow: 0 4px 10px rgba(0,0,0,0.25);
    z-index: 15;
  }
  .footer-stats {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: var(--azul-medio);
    color: white;
    padding: 10px 16px;
    display: flex;
    justify-content: space-between;
    font-size: 0.85em;
    z-index: 20;
  }
  .footer-stats div { text-align: center; }
  .footer-stats strong { display: block; font-size: 1.05em; }
  .modal-bg {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    z-index: 50;
    align-items: flex-end;
  }
  .modal-bg.active { display: flex; }
  .modal {
    background: white;
    width: 100%;
    border-radius: 18px 18px 0 0;
    padding: 20px;
    max-height: 88vh;
    overflow-y: auto;
  }
  .modal h2 { margin-top: 0; font-size: 1.1em; }
  .close-x { float: right; background: none; border: none; font-size: 1.3em; color: #999; }
  .dia-selector { display: flex; gap: 6px; flex-wrap: wrap; margin: 8px 0; }
  .dia-chip {
    padding: 6px 10px;
    border-radius: 8px;
    background: #eee;
    font-size: 0.75em;
    border: none;
  }
  .dia-chip.activo { background: var(--celeste); color: white; }
  .preview-box {
    background: var(--arena);
    border-radius: 10px;
    padding: 10px 14px;
    margin: 8px 0;
    text-align: center;
    font-size: 1.05em;
  }
  .visitado-tag {
    display: inline-block;
    background: var(--verde-pago);
    color: white;
    font-size: 0.7em;
    padding: 2px 8px;
    border-radius: 6px;
    margin-left: 6px;
  }
  /* Panel desplegable de busqueda */
  .panel-desplegable {
    display: none;
    background: var(--azul-medio);
    padding: 10px 12px 14px;
  }
  .panel-desplegable.activo { display: block; }
  .filtro-tabs { display: flex; gap: 6px; margin-bottom: 8px; }
  .filtro-tab {
    flex: 1;
    padding: 8px 4px;
    background: transparent;
    border: 1px solid white;
    border-radius: 8px;
    color: white;
    font-size: 0.8em;
  }
  .filtro-tab.activo { background: var(--azul-hondo); }
  .panel-desplegable input {
    background: white;
    margin: 0;
  }
  /* Menu hamburguesa */
  .menu-dropdown {
    display: none;
    position: absolute;
    top: 54px;
    left: 8px;
    background: white;
    color: var(--texto);
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.25);
    z-index: 30;
    min-width: 190px;
    overflow: hidden;
  }
  .menu-dropdown.activo { display: block; }
  .menu-dropdown button {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 12px 14px;
    font-size: 0.9em;
    color: var(--texto);
    border-bottom: 1px solid #eee;
  }
  /* Selector de dia desplegable */
  .dia-dropdown {
    display: none;
    position: absolute;
    top: 54px;
    right: 60px;
    background: white;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.25);
    z-index: 30;
    padding: 10px;
  }
  .dia-dropdown.activo { display: block; }
  .dia-dropdown .dia-chip { color: var(--texto); }
  /* Estadisticas */
  .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
  .stat-box {
    border-radius: 12px;
    padding: 16px 8px;
    text-align: center;
    color: white;
    font-size: 0.85em;
  }
  .stat-box .num { font-size: 1.3em; font-weight: bold; display: block; margin-bottom: 4px; }
  .banner-deshacer {
    display: none;
    position: fixed;
    bottom: 60px; left: 12px; right: 12px;
    background: var(--azul-hondo);
    color: white;
    border-radius: 10px;
    padding: 12px 14px;
    z-index: 60;
    align-items: center;
    justify-content: space-between;
  }
  .banner-deshacer.activo { display: flex; }
  .banner-deshacer button {
    background: var(--naranja);
    color: white;
    border: none;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 0.85em;
  }
</style>
</head>
<body>

<header style="position:relative;">
  <div style="text-align:center; padding-top:8px; font-weight:bold; font-size:1.15em; letter-spacing:1px;">💧 LA NORIA</div>
  <div style="text-align:center; font-size:0.78em; opacity:0.85;" id="fechaHoyLabel"></div>
  <div class="topbar">
    <button class="icon-btn" onclick="toggleMenu()">☰</button>
    <button class="icon-btn" id="btnAgregarTop">➕👤</button>
    <button class="icon-btn" onclick="togglePanel('panelBusqueda')">🔍</button>
    <button class="icon-btn" onclick="togglePanel('diaDropdown')">📅</button>
    <button class="icon-btn" onclick="renderTodo()">🔄</button>
  </div>

  <div class="menu-dropdown" id="menuDropdown">
    <button onclick="abrirModalCargarReparto()">📥 Cargar reparto del día</button>
    <button onclick="importarDesdeContactos()">📇 Importar clientes desde Contactos</button>
    <button onclick="mostrarEstadisticas()">📊 Resumen del día</button>
    <button onclick="mostrarHistorialFecha()">📜 Historial (por fecha o cliente)</button>
    <button onclick="mostrarStockCamion()">🚚 Stock del camión</button>
    <button onclick="mostrarReporteSemanal()">📈 Reporte semanal</button>
    <button onclick="exportarRespaldo()">💾 Descargar respaldo</button>
    <button onclick="compartirRespaldo()">📤 Enviar respaldo (Drive / Email / WhatsApp)</button>
    <button onclick="document.getElementById('inputRestaurar').click()">📂 Restaurar respaldo</button>
    <button onclick="cerrarMenus()">✕ Cerrar</button>
  </div>
  <input type="file" id="inputRestaurar" accept="application/json" style="display:none;" onchange="restaurarRespaldo(event)">

  <div class="dia-dropdown" id="diaDropdown">
    <label style="color:var(--texto);">Consultar clientes de otro día:</label>
    <div class="dia-selector" id="selectorDiaVista"></div>
  </div>

  <div class="panel-desplegable" id="panelBusqueda">
    <div class="filtro-tabs" id="filtroTabs"></div>
    <input type="text" id="inputBusqueda" placeholder="Búsqueda por nombre de cliente" oninput="onBuscar()">
  </div>

  <div class="tabs">
    <button class="tab-btn active" data-tab="porVisitar">Por visitar</button>
    <button class="tab-btn" data-tab="atendidos">Atendidos</button>
    <button class="tab-btn" data-tab="fueraReparto">Fuera de reparto</button>
  </div>
</header>

<!-- POR VISITAR: los del reparto de hoy que todavia no atendiste -->
<div class="view active" id="view-porVisitar">
  <div class="card" style="text-align:center;">
    <strong id="tituloDiaHoy">Ruta de hoy</strong>
  </div>
  <div id="listaPorVisitar"></div>
</div>

<!-- ATENDIDOS: los del reparto de hoy que ya visitaste -->
<div class="view" id="view-atendidos">
  <div id="listaAtendidos"></div>
</div>

<!-- FUERA DE REPARTO: clientes que no estan programados para hoy, para venderles igual -->
<div class="view" id="view-fueraReparto">
  <div class="card">
    <input type="text" id="inputBuscadorFuera" placeholder="Buscar cliente para agregar a fuera de reparto..." oninput="renderFueraDeReparto()">
  </div>
  <div id="listaFueraReparto"></div>
</div>

<!-- ESTADISTICAS -->
<div class="view" id="view-estadisticas">
  <button class="btn outline" onclick="volverDeEstadisticas()">← Volver</button>
  <h2 style="text-align:center;">Resumen del día</h2>
  <div class="stat-grid">
    <div class="stat-box" style="background:#29b6d8;"><span class="num" id="estVenta">$0</span>Venta total</div>
    <div class="stat-box" style="background:#2e8b57;"><span class="num" id="estEfectivo">$0</span>Efectivo</div>
    <div class="stat-box" style="background:#7c8ff0;"><span class="num" id="estTransferencia">$0</span>Transferencia</div>
    <div class="stat-box" style="background:#c0392b;"><span class="num" id="estDeuda">$0</span>Deuda</div>
    <div class="stat-box" style="background:#2e8b57;"><span class="num" id="estVisitados">0/0</span>Clientes visitados</div>
    <div class="stat-box" style="background:#e08a3e;"><span class="num" id="estEntregados">0</span>Envases entregados</div>
    <div class="stat-box" style="background:#1a6fa8;"><span class="num" id="estRecibidos">0</span>Envases recibidos</div>
    <div class="stat-box" style="background:#5c5c5c;"><span class="num" id="estClientesTotal">0</span>Clientes totales</div>
  </div>
  <button class="btn naranja" onclick="cerrarRepartoDelDia()">🔒 Cerrar reparto del día</button>
  <p style="font-size:0.78em; color:#666;" id="estadoCierreHoy"></p>
  <button class="btn outline" onclick="mostrarReporteSemanal()">📈 Ver reporte semanal</button>
</div>

<!-- HISTORIAL (por fecha o por cliente) -->
<div class="view" id="view-historialFecha">
  <button class="btn outline" onclick="volverDeEstadisticas()">← Volver</button>
  <h2 style="text-align:center;">Historial</h2>
  <div class="btn-row">
    <button class="btn" id="btnHistPorFecha" onclick="cambiarSubtabHistorial('fecha')">Por fecha</button>
    <button class="btn outline" id="btnHistPorCliente" onclick="cambiarSubtabHistorial('cliente')">Por cliente</button>
  </div>

  <div id="histPorFecha">
    <input type="date" id="inputFechaHistorial" onchange="renderHistorialFecha()">
    <div id="listaHistorialFecha"></div>
  </div>

  <div id="histPorCliente" style="display:none;">
    <input type="text" id="inputBuscarClienteHist" placeholder="Buscar cliente por nombre" oninput="renderHistorialPorCliente()">
    <div id="listaHistorialPorCliente"></div>
  </div>
</div>

<!-- CONSULTAR OTRO DIA -->
<div class="view" id="view-consultaDia">
  <button class="btn outline" onclick="volverDeEstadisticas()">← Volver</button>
  <h2 style="text-align:center;" id="tituloConsultaDia">Clientes de...</h2>
  <p style="font-size:0.78em; color:#666; text-align:center;">Esto es solo para consultar o venderle a alguien fuera del reparto de hoy. No cambia tu reparto activo.</p>
  <div id="listaConsultaDia"></div>
</div>

<!-- REPORTE SEMANAL -->
<div class="view" id="view-reporteSemanal">
  <button class="btn outline" onclick="volverDeEstadisticas()">← Volver</button>
  <h2 style="text-align:center;">Reporte semanal</h2>
  <p style="font-size:0.8em; color:#666; text-align:center;">Últimos 7 días (con el reparto cerrado)</p>
  <div id="listaReporteSemanal"></div>
  <div class="card" style="background:var(--azul-hondo); color:white;">
    <h3>Total de la semana</h3>
    <div class="row"><span>Venta total:</span><strong id="semVenta">$0</strong></div>
    <div class="row"><span>Efectivo:</span><strong id="semEfectivo">$0</strong></div>
    <div class="row"><span>Transferencia:</span><strong id="semTransferencia">$0</strong></div>
    <div class="row"><span>Fiado:</span><strong id="semDeuda">$0</strong></div>
    <div class="row"><span>Envases entregados:</span><strong id="semEntregados">0</strong></div>
    <div class="row"><span>Envases recibidos:</span><strong id="semRecibidos">0</strong></div>
  </div>
</div>

<!-- STOCK DEL CAMION -->
<div class="view" id="view-stockCamion">
  <button class="btn outline" onclick="volverDeEstadisticas()">← Volver</button>
  <h2 style="text-align:center;">Stock del camión</h2>

  <div class="card" style="text-align:center; background:var(--celeste); color:white;">
    <span style="font-size:0.85em;">Envases vacíos que te dieron hoy</span>
    <div style="font-size:1.6em; font-weight:bold;" id="stockEnvasesVaciosHoy">0</div>
  </div>

  <div class="card">
    <h3>💧 Bidones 20 Lts</h3>
    <div class="row"><span>Te quedan llenos:</span><strong id="stockB20">0</strong></div>
    <label>Cargar stock al arrancar el día (reemplaza lo que había)</label>
    <input type="number" inputmode="numeric" id="inputStockB20" placeholder="Ej: 50">
    <label>Sumar más (volviste a cargar sin perder lo que quedaba)</label>
    <div class="btn-row">
      <input type="number" inputmode="numeric" id="inputSumarB20" placeholder="Ej: 20" style="margin:0;">
      <button class="btn chico" onclick="sumarStock('b20')">＋ Sumar</button>
    </div>
  </div>

  <div class="card">
    <h3>💧 Bidones 10/12 Lts</h3>
    <div class="row"><span>Te quedan llenos:</span><strong id="stockB10">0</strong></div>
    <label>Cargar stock al arrancar el día (reemplaza lo que había)</label>
    <input type="number" inputmode="numeric" id="inputStockB10" placeholder="Ej: 3">
    <label>Sumar más</label>
    <div class="btn-row">
      <input type="number" inputmode="numeric" id="inputSumarB10" placeholder="Ej: 2" style="margin:0;">
      <button class="btn chico" onclick="sumarStock('b10')">＋ Sumar</button>
    </div>
    <div class="btn-row">
      <button class="btn chico outline" onclick="ajustarStockManual('b10',-1)">－ vendí uno</button>
      <button class="btn chico outline" onclick="ajustarStockManual('b10',1)">＋ corregir</button>
    </div>
  </div>

  <div class="card">
    <h3>🧊 Dispensers</h3>
    <div class="row"><span>Te quedan:</span><strong id="stockDisp">0</strong></div>
    <label>Cargar stock al arrancar el día (reemplaza lo que había)</label>
    <input type="number" inputmode="numeric" id="inputStockDisp" placeholder="Ej: 2">
    <label>Sumar más</label>
    <div class="btn-row">
      <input type="number" inputmode="numeric" id="inputSumarDisp" placeholder="Ej: 1" style="margin:0;">
      <button class="btn chico" onclick="sumarStock('disp')">＋ Sumar</button>
    </div>
    <div class="btn-row">
      <button class="btn chico outline" onclick="ajustarStockManual('disp',-1)">－ vendí uno</button>
      <button class="btn chico outline" onclick="ajustarStockManual('disp',1)">＋ corregir</button>
    </div>
  </div>

  <button class="btn naranja" onclick="cargarStockInicial()">Guardar stock inicial (reemplaza)</button>
  <p style="font-size:0.78em; color:#666; margin-top:10px;">
    Los bidones de 20 Lts y los envases vacíos recibidos se descuentan/suman solos con cada venta.
    Los de 10/12 Lts y los dispensers todavía se ajustan a mano con los botones.
  </p>
</div>


<button class="fab" id="btnAgregar">+</button>

<button id="btnInstalarApp" style="display:none; position:fixed; bottom:80px; left:12px; right:12px; z-index:70; background:var(--naranja); color:white; border:none; padding:14px; border-radius:10px; font-size:1em; font-weight:bold;">
  📲 Instalar LA NORIA en la pantalla de inicio
</button>

<div class="banner-deshacer" id="bannerDeshacer">
  <span id="bannerDeshacerTexto">Cliente eliminado</span>
  <button onclick="deshacerEliminacion()">Deshacer</button>
</div>

<div class="footer-stats">
  <div><strong id="statVendido">$0</strong>Vendido</div>
  <div><strong id="statCobrado">$0</strong>Cobrado</div>
  <div><strong id="statVisitas">0/0</strong>Visitas</div>
</div>

<!-- MODAL NUEVO CLIENTE -->
<div class="modal-bg" id="modalCliente">
  <div class="modal">
    <button class="close-x" onclick="cerrarModal('modalCliente')">×</button>
    <h2 id="tituloModalCliente">Nuevo cliente</h2>

    <div class="section-title">Datos del cliente</div>
    <label>Nombre</label>
    <input type="text" id="inputNombre" placeholder="Ej: Doña Rosa">
    <label>Teléfono</label>
    <input type="tel" inputmode="numeric" pattern="[0-9]*" id="inputTelefono" placeholder="Solo números">

    <div class="section-title">Dirección</div>
    <label>Calle y altura</label>
    <input type="text" id="inputDireccion" placeholder="Ej: Calle 5, 823">

    <div class="section-title">Configuración</div>
    <label>Precio por bidón ($)</label>
    <input type="number" inputmode="numeric" id="inputPrecio" placeholder="Ej: 5000">
    <label>Frecuencia de visita (días)</label>
    <div class="dia-selector" id="diasClienteSelector"></div>

    <div class="section-title">Orden en el recorrido</div>
    <label>Va después de qué cliente (en su día de reparto)</label>
    <select id="inputDespuesDe">
      <option value="">Al final del recorrido</option>
    </select>

    <button class="btn naranja" onclick="guardarCliente()">Guardar cliente</button>
  </div>
</div>

<!-- MODAL STOCK / REGISTRAR COMPRA -->
<div class="modal-bg" id="modalStock">
  <div class="modal">
    <button class="close-x" onclick="cerrarModal('modalStock')">×</button>
    <h2 id="nombreStock">Cliente</h2>
    <div class="row"><span>Saldo actual:</span><strong id="saldoActualStock">$0</strong></div>
    <div class="row"><span>Envases que debe:</span><strong id="bidonesPoderStock">0</strong></div>
    <hr>
    <label>Bidones que compra</label>
    <input type="number" inputmode="numeric" id="stkBidones" value="1" min="0" oninput="actualizarPreviewStock()">
    <label>Envases vacíos que devuelve</label>
    <input type="number" inputmode="numeric" id="stkEnvases" value="0" min="0">
    <div class="preview-box">Total de esta compra: <strong id="stkPreview">$0</strong></div>

    <div class="btn-row">
      <button class="btn verde" onclick="confirmarStock('efectivo')">Efectivo</button>
      <button class="btn" onclick="confirmarStock('transferencia')">Transferencia</button>
    </div>

    <label style="margin-top:10px;">¿Cuánto te entrega ahora? (parcial o fiado)</label>
    <input type="number" inputmode="numeric" id="stkEntregado" placeholder="0">
    <button class="btn naranja" onclick="confirmarStock('entregado')">Registrar lo entregado</button>

    <button class="btn outline" onclick="marcarNoCompra()">No compra</button>
  </div>
</div>

<!-- MODAL DETALLE / HISTORIAL CLIENTE -->
<div class="modal-bg" id="modalDetalle">
  <div class="modal">
    <button class="close-x" onclick="cerrarModal('modalDetalle')">×</button>
    <h2 id="nombreDetalle">Cliente</h2>
    <div class="row"><span>Saldo actual:</span><strong id="saldoDetalle">$0</strong></div>
    <div class="row"><span>Envases que debe:</span><strong id="envasesDetalle">0</strong></div>
    <div class="row"><span>Días de reparto:</span><strong id="diasDetalle">-</strong></div>
    <div class="btn-row" id="botonesContacto"></div>
    <button class="btn outline" onclick="abrirEditarCliente()">✏️ Editar datos del cliente</button>
    <hr>
    <label>Registrar pago (salda deuda vieja)</label>
    <input type="number" inputmode="numeric" id="inputPago" placeholder="Monto $">
    <button class="btn naranja" onclick="registrarPago()">Registrar pago</button>
    <hr>
    <button class="btn rojo" onclick="borrarCliente()">Eliminar cliente</button>
    <h3>Historial</h3>
    <div class="movimientos" id="historialCliente"></div>
  </div>
</div>

<!-- MODAL CARGAR REPARTO (elegir dia activo) -->
<div class="modal-bg" id="modalCargarReparto">
  <div class="modal">
